# Registros
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Directorios y archivos del editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Credenciales y estado local de despliegue
.env
.env.*
!.env.example
.wrangler/
# Panorama de referencia sin uso (no forma parte de la aplicación)
data/reference/*.exr
# Datos crudos de exoplanetas (137 MB): se descargan con las URL de FUENTES.md
data/raw/exoplanets/*
!data/raw/exoplanets/FUENTES.md
# Datos crudos de Gaia (21 MB) y tabla de identidad regenerable (31 MB)
data/raw/gaia/*
!data/raw/gaia/FUENTES.md
data/catalog/star_identity.json
# Datos crudos de SIMBAD (4,9 MB)
data/raw/simbad/*
!data/raw/simbad/FUENTES.md

# Documentos de trabajo, relevo y decisiones: solo en la carpeta local
/AGENTS.md
/CLAUDE.md
/HOSHI_*.md
/PENDIENTES.md
/docs/*
!/docs/DOCUMENTACION.md
!/docs/HISTORIAL.md
/.claude/
# Material de referencia local
/data/reference/
# Retirados del repositorio por no usarse en la aplicación; las copias locales pueden borrarse
/public/propuestas/
/data/processed/milkyway_desi.json
/scripts/export_milkyway.js
