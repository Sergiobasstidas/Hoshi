# Registros
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Directorios y archivos del editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Credenciales y estado local de despliegue
.env
.env.*
!.env.example
.wrangler/
# Panorama de referencia sin uso (no forma parte de la aplicación)
data/reference/*.exr
# Datos crudos de exoplanetas (137 MB): se descargan con las URL de FUENTES.md
data/raw/exoplanets/*
!data/raw/exoplanets/FUENTES.md
# Datos crudos de Gaia (21 MB) y tabla de identidad regenerable (31 MB)
data/raw/gaia/*
!data/raw/gaia/FUENTES.md
data/catalog/star_identity.json
# Selección de la capa del millón que deja scripts/process_gaia.js para el registro HSB (regenerable)
data/catalog/gaia_1m_seleccion.csv.gz
data/catalog/gaia_capa_orden.txt.gz
# AT-HYG v3.2 completo (199 MB): se descarga con las URL de FUENTES.md
data/raw/athyg/*
!data/raw/athyg/FUENTES.md
# Datos crudos de SIMBAD (4,9 MB)
data/raw/simbad/*
!data/raw/simbad/FUENTES.md

# Notas de trabajo locales: solo la documentación pública de docs/ se versiona
/HOSHI_*.md
/PENDIENTES.md
/docs/*
!/docs/DOCUMENTACION.md
# Material de referencia local
/data/reference/
# Retirados del repositorio por no usarse en la aplicación; las copias locales pueden borrarse
/public/propuestas/
/data/processed/milkyway_desi.json
/scripts/export_milkyway.js

# Fuentes de lunas y anillos: descargas de JPL, PDS y Wikipedia; sus URL están en los generadores.
data/moons/fuentes/
data/rings/fuentes/
# Vectores de Horizons de los planetas (≈ 25 MB): se descargan con scripts/planets/fetch_planets.mjs.
data/planets/fuentes/
# Estrellas cercanas y 2MASS (≈ 56 MB): se descargan con scripts/catalog/descargar_cercanas.py
data/raw/gcns/*
!data/raw/gcns/FUENTES.md
data/raw/cns5/*
!data/raw/cns5/FUENTES.md
data/raw/tmass/*
!data/raw/tmass/FUENTES.md
# Respuestas guardadas de SIMBAD, NASA, MAST, Gaia y JMDC (≈ 8 MB): npm run descargar:red
data/raw/red/*
!data/raw/red/FUENTES.md
# Hipparcos, nueva reducción (4,7 MB): python3 scripts/catalog/descargar_cercanas.py hipparcos
data/raw/hipparcos/*
!data/raw/hipparcos/FUENTES.md
